<style>
    /* ========================================================
       DYNAMIC SECTION SPACING (FROM SCHEMA)
       Converted to Margins to allow negative values!
       ======================================================== */
    #m-featured-product-{{ section.id }} {
      margin-top: {{ section.settings.padding_top_mobile }}px !important;
      margin-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
      padding-top: 0px !important;
      padding-bottom: 0px !important;
    }
    @media (min-width: 768px) {
      #m-featured-product-{{ section.id }} {
        margin-top: {{ section.settings.padding_top }}px !important;
        margin-bottom: {{ section.settings.padding_bottom }}px !important;
      }
    }

    /* Force any internal wrappers to drop their default spacing */
    #m-featured-product-{{ section.id }} > div[class*="m-section-"] {
       margin-top: 0px !important;
       margin-bottom: 0px !important;
       padding-top: 0px !important;
       padding-bottom: 0px !important;
    }

    /* ========================================================
       MOBILE LAYOUT REORDER: Title -> Stars -> Image -> Price
       ======================================================== */
    @media (max-width: 767px) {
      /* Turn the main wrapper into a column flexbox */
      .m-main-product--wrapper {
        display: flex !important;
        flex-direction: column !important;
      }
      
      /* 'display: contents' strips the wrapper visually so items can be sorted together. */
      .m-main-product--info,
      .m-product-info--wrapper {
        display: contents !important;
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
        visibility: visible !important;
      }
      
      /* Default ALL blocks to go BELOW the image, retaining their natural order */
      .main-product__block {
        order: 10 !important;
        width: 100% !important;
        padding-left: {{ section.settings.padding_horizontal_mobile }}px !important;
        padding-right: {{ section.settings.padding_horizontal_mobile }}px !important;
        box-sizing: border-box !important;
      }

      /* 0. Badges (like Sale tags) go very first */
      .main-product__block-badge {
        order: 0 !important;
      }
      
      /* 1. Pull ONLY the Title to the top */
      .main-product__block-title {
        order: 1 !important;
        margin-top: 0px !important;
        margin-bottom: 5px !important;
      }
      
      /* 2. Pull ONLY the App blocks (Judge.me Stars) under the title */
      .main-product__block-\@app,
      [class*="main-product__block-@app"] {
        order: 2 !important;
        margin-bottom: 15px !important;
      }
      
    /* 3. Place the Image Gallery under the stars */
      .m-main-product--media {
        order: 3 !important;
        width: 100% !important;
        margin-bottom: 15px !important;
        display: block !important;
        scroll-margin-top: 150px !important;
        overflow-anchor: none !important;
      }

      /* 4. Pull the Price right under the image */
      .main-product__block-price {
        order: 4 !important;
        margin-bottom: 15px !important;
      }
      
      /* 5. Everything else (Custom liquid, Buttons) is order 10 and stays at the bottom! */
    }

    /* Add this CSS to make the left column sticky */
    @media (min-width: 768px) {
      /* 1. THE NUCLEAR OPTION: Strip away anything that breaks sticky on desktop */
      html, body,
      #MainContent,
      #shopify-section-{{ section.id }},
      #m-featured-product-{{ section.id }},
      #m-featured-product-{{ section.id }} > div,
      .m-main-product--wrapper {
        overflow: visible !important;
        overflow-x: visible !important;
        overflow-y: visible !important;
        transform: none !important;
        animation: none !important;
        contain: none !important;
        clip-path: none !important;
      }

      /* 2. Force the flex container to allow children to be their natural height */
      .m-main-product--wrapper {
        align-items: flex-start !important;
        display: flex !important;
      }

      /* 3. BRUTE FORCE STICKY */
      .m-main-product--media {
        position: -webkit-sticky !important;
        position: sticky !important;
        top: 90px !important; /* Clears your header */
        height: max-content !important; /* Critical: Stops it from stretching */
        align-self: flex-start !important;
        z-index: 99 !important;
      }
    }

    /* Final Attempt: Hiding CSS pseudo-elements */
  .m-main-product--media .swiper-button-control::before,
  .m-main-product--media .swiper-button-control::after {
      content: none !important;
      display: none !important;
  }
  
  /* Custom CSS for the rounded Quantity Selector */
    .m-quantity {
        display: flex; 
        border: 1px solid currentColor; 
        border-radius: 9999px; 
        overflow: hidden; 
        max-width: fit-content; 
        height: 40px; 
    }
    .m-quantity__input {
        width: 40px; 
        padding: 0; 
        border: none !important; 
        outline: none; 
        background-color: transparent; 
        height: 100%; 
    }
    .m-quantity__button {
        width: 40px; 
        height: 100%; 
        background-color: transparent;
        border: none; 
        cursor: pointer;
        padding: 0; 
        flex-shrink: 0; 
    }
    .m-quantity__button svg {
        width: 14px; 
        height: 14px;
        pointer-events: none; 
    }
    .m-quantity:focus-within {
        border-color: #000;
    }
    .m-product-form--input > label.m-product-option--label {
        display: none;
    }
    .m-product-form--wrapper {
        align-items: center; 
    }
    .m-product-form--input {
        margin-right: 1rem; 
    }

    /* --- NEW CUSTOM PLAY BUTTON STYLES & ANIMATION --- */
    .m-product-media--slider__thumbnail-icon.custom-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70px;
        height: 70px;
        background-color: rgba(235, 235, 235, 0.85); /* Light greyish-white circle */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        cursor: pointer;
        transition: all 0.3s ease;
        animation: play-pulse 2s infinite; /* Pulsing animation */
    }

    .m-product-media--slider__thumbnail-icon.custom-play-btn svg {
        width: 28px;
        height: 28px;
        margin-left: 10px; /* Offsets triangle slightly so it looks visually centered */
        color: #396561; /* Dark green/teal matching your image */
        fill: currentColor;
    }

    .m-product-media--slider__thumbnail-icon.custom-play-btn:hover {
        transform: translate(-50%, -50%) scale(1.1);
        background-color: rgba(255, 255, 255, 1);
        animation: none; /* Stops pulse on hover */
    }

    @keyframes play-pulse {
        0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6); }
        70% { box-shadow: 0 0 0 15px rgba(255, 255, 255, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
    }
    /* ==========================================================
     SIDE-BY-SIDE EXPRESS CHECKOUT (Featured Product & Sticky Cart)
     ========================================================== */
  
  /* 1. Force floats for Side-by-Side */
  .m-featured-product .shopify-payment-button,
  .m-featured-product shopify-accelerated-checkout,
  [id^="vistagato-mobile-cart-bar-"] .shopify-payment-button,
  [id^="vistagato-mobile-cart-bar-"] shopify-accelerated-checkout {
    display: block !important;
    width: 100% !important;
    overflow: hidden !important; 
    margin-top: 5px !important;
  }

  /* 2. Target dynamic button (PayPal, Apple Pay, etc.) and float left */
  .m-featured-product shopify-accelerated-checkout > :not(more-payment-options-link),
  [id^="vistagato-mobile-cart-bar-"] shopify-accelerated-checkout > :not(more-payment-options-link) {
    display: block !important;
    float: left !important;
    width: 48% !important;
    margin: 0 !important;
    clear: none !important;
  }

  /* 3. Target Credit Card button and float right */
  .m-featured-product more-payment-options-link,
  [id^="vistagato-mobile-cart-bar-"] more-payment-options-link {
    display: block !important;
    float: right !important;
    width: 48% !important;
    margin: 0 !important;
    clear: none !important;
  }

  /* 4. Tweak the green button to fit the Side-by-Side space */
  .m-featured-product .shopify-payment-button__more-options,
  [id^="vistagato-mobile-cart-bar-"] .shopify-payment-button__more-options {
    height: 44px !important; 
    margin-top: 0 !important; /* Removes vertical stacking gap */
    padding: 0 4px !important; 
  }

  .m-featured-product .shopify-payment-button__more-options::after,
  [id^="vistagato-mobile-cart-bar-"] .shopify-payment-button__more-options::after {
    font-size: 12px !important; /* Scaled down for mobile */
    white-space: nowrap !important;
  }
</style>

{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign product = all_products[section.settings.featured_product]
  assign first_3d_model = product.media | where: 'media_type', 'model' | first

  if product == empty
    assign section_onboarding = true
  endif

  assign bg_color = section.settings.background_color
  assign has_bg = false

  unless bg_color == 'rgba(0,0,0,0)' or bg_color == blank
    assign has_bg = true
  endunless

  assign image_placement = section.settings.image_placement

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
-%}
{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{% capture onboarding %}
  <div class="m-product-info--wrapper m:text-color-body">
    <div class="main-product__block main-product__block-title">
      <a class="m-product-title" href="#">
        {{ 'homepage.onboarding.product_title' | t }}
      </a>
    </div>
    <div class="main-product__block main-product__block-price">
      <span class="m:text-xl">
        {{ 1999 | money }}
      </span>
    </div>
    <div class="main-product__block main-product__block-description m-product-description">
      {{ 'homepage.onboarding.product_description' | t }}
    </div>
    <div class="main-product__block main-product__block-buy_buttons">
      <button type="submit" class="m-add-to-cart m-button m-button--primary m:w-full">
        <span>{{ 'products.product.add_to_cart' | t }}</span>
      </button>
    </div>
  </div>
{% endcapture %}

<div
  id="m-featured-product-{{ section.id }}"
  data-section-type="featured-product"
  data-section-id="{{ section.id }}"
  class="m-section m-featured-product {{ section.settings.custom_class }} {{ first_3d_model }}"
  {% if has_bg %}
    data-bg="{{ bg_color | color_to_hsl }}"
  {% endif %}
  style="background-color: {{ bg_color }};"
>
  <div class="{{ container }}{% if has_bg == false %} m-section-my{% else %} m-section-py{% endif %}">
    <div
      class="m:flex m:flex-wrap m-main-product--wrapper"
      data-view="featured-product"
      style="--column-gap: {{ section.settings.column_gap }}px; --column-gap-mobile: {{ section.settings.column_gap_mobile }}px;"
    >
      <div
        class="m:column md:m:w-1/2 m:w-full m-main-product--media"
        {% if image_placement == 'right' %}
          style="order:2;"
        {% endif %}
      >
        {% unless section_onboarding %}
          {% render 'product-media', section: section, media_layout: 'layout-4', product: product, template_product: true %}
        {% else %}
          <div
            class="{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
            style="--aspect-ratio: 1/1;"
          >
            {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg m:object-cover' }}
          </div>
        {% endunless %}
      </div>
      <div class="m:column md:m:w-1/2 m:w-full m-main-product--info{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        {% if section_onboarding %}
          {{ onboarding }}
        {% else %}
          <div class="m-product-info--wrapper m:text-color-body">
            {% render 'main-product-blocks',
              product: product,
              section: section,
              update_browser_history: false,
              is_featured: true
            %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% if product.media.size > 0 %}
  <script src="{{ 'product-media.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- if first_3d_model -%}
  <script src="{{ 'product-model.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% if product.options_with_values.size > 0 %}
  <script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% if product != blank %}
  {% render 'product-data', product: product %}
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.innerWidth >= 768) {
      setInterval(function() {
        var stickyTarget = document.querySelector('.m-main-product--media');
        if(stickyTarget) {
          var parent = stickyTarget.parentElement;
          while(parent && parent.tagName !== 'HTML') {
            var computedStyle = window.getComputedStyle(parent);
            if(computedStyle.overflow === 'hidden' || computedStyle.overflowX === 'hidden' || computedStyle.overflowY === 'hidden' || computedStyle.transform !== 'none') {
              parent.style.setProperty('overflow', 'visible', 'important');
              parent.style.setProperty('overflow-x', 'visible', 'important');
              parent.style.setProperty('overflow-y', 'visible', 'important');
              parent.style.setProperty('transform', 'none', 'important');
              parent.style.setProperty('animation', 'none', 'important');
            }
            parent = parent.parentElement;
          }
        }
      }, 1000); // Scans every second to ensure the theme doesn't override our fix
    }
  });
</script>

{%- if product != blank and product.media.size > 0 -%}
  {%- for media in product.media -%}
    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
      
      {%- comment -%} Determine values: Prioritize metafields, fallback to product data {%- endcomment -%}
      {%- assign schema_title = product.metafields.custom.video_schema_title | default: product.title | escape -%}
      {%- assign schema_desc = product.metafields.custom.video_schema_desc | default: product.description | strip_html | truncate: 150 | escape -%}
      {%- assign schema_date = product.metafields.custom.video_schema_date | default: product.published_at | date: '%Y-%m-%d' -%}
      
      {%- comment -%} Get the correct video URL depending on if it's uploaded to Shopify or Youtube {%- endcomment -%}
      {%- if media.media_type == 'external_video' -%}
        {%- assign schema_url = media | external_video_url -%}
      {%- else -%}
        {%- assign schema_url = media.sources[1].url | default: media.sources[0].url -%}
      {%- endif -%}

      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "VideoObject",
        "name": {{ schema_title | json }},
        "description": {{ schema_desc | json }},
        "thumbnailUrl": {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }},
        "uploadDate": {{ schema_date | json }},
        "contentUrl": {{ schema_url | json }}
      }
      </script>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<script>
  /* ANTI-JUMP / ANTI-ANCHOR BYPASS SCRIPT */
  /* This breaks the buggy text-check but keeps the badge clickable! */
  document.addEventListener('DOMContentLoaded', function() {
    const observer = new MutationObserver(function() {
      document.querySelectorAll('.jdgm-prev-badge__text').forEach(function(el) {
        if (el.innerText.includes('out of 5') && !el.dataset.fixed) {
          el.innerHTML = el.innerHTML.replace(/out of 5/g, 'out of&#8203; 5');
          el.innerHTML = el.innerHTML.replace(/150 Reviews/gi, '150&#8203; Reviews');
          el.dataset.fixed = 'true';
        }
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>
<script>
  /* The brute-force JS hack to move the intro text below the image on mobile */
  document.addEventListener('DOMContentLoaded', function() {
    if (window.innerWidth <= 767) {
      const liquidBlocks = document.querySelectorAll('.main-product__block-custom_liquid');
      const mediaContainer = document.querySelector('.m-main-product--media');
      
      // List of all the text variations we want to move
      const targetPhrases = [
        'Is your indoor cat scratching',
        'Still dealing with indoor odors',
        'Does your cat crave the outdoors'
      ];
      
      if (mediaContainer) {
        liquidBlocks.forEach(block => {
          // Check if the current block has ANY of the phrases in our list
          const isTargetBlock = targetPhrases.some(phrase => block.textContent.includes(phrase));
          
          if (isTargetBlock) {
            // Strip any conflicting flex ordering
            block.style.setProperty('order', 'initial', 'important');
            block.style.setProperty('margin-top', '20px', 'important');
            
            // Shove it directly INSIDE the bottom of the media container
            mediaContainer.appendChild(block);
          }
        });
      }
    }
  });
</script>
{%- comment -%} 
  -------------------------------------------------------------
  VISTAGATO MOBILE STICKY CART (FEATURED PRODUCT SCOPED)
  -------------------------------------------------------------
{%- endcomment -%}
{% if product != blank %}
<style>
  @media screen and (max-width: 768px) {
    body {
      padding-bottom: 190px !important;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 99999;
      background: #ffffff;
      border-top: 1px solid #dddddd;
      box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.12);
      padding: 10px 12px 14px;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-product-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-product-image {
      width: 58px;
      height: 58px;
      border-radius: 8px;
      object-fit: cover;
      border: 1px solid #eeeeee;
      flex: 0 0 58px;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-product-info {
      flex: 1;
      min-width: 0;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-product-title {
      margin: 0 0 3px;
      font-size: 14px;
      line-height: 1.25;
      font-weight: 700;
      color: #222222;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-product-price {
      font-size: 14px;
      font-weight: 700;
      color: #286968;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-action-row {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 10px;
      align-items: center;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-qty {
      display: flex;
      align-items: center;
      height: 46px;
      border: 1px solid #286968;
      border-radius: 999px;
      overflow: hidden;
      background: #ffffff;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-qty button {
      width: 31px;
      height: 46px;
      border: 0;
      background: transparent;
      color: #286968;
      font-size: 20px;
      font-weight: 700;
      line-height: 1;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-qty input {
      width: 34px;
      height: 46px;
      border: 0;
      text-align: center;
      font-size: 15px;
      font-weight: 700;
      color: #222222;
      padding: 0;
      -moz-appearance: textfield;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-qty input::-webkit-outer-spin-button,
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-qty input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-add-to-cart {
      width: 100%;
      height: 46px;
      border: 0;
      border-radius: 999px;
      background: #286968;
      color: #ffffff;
      font-size: 15px;
      font-weight: 700;
      text-align: center;
    }
    /* Shopify's `available` already accounts for "continue selling when out of
       stock", so a deliberate pre-order keeps its normal button. */
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-add-to-cart[disabled] {
      opacity: 1; /* the theme's [disabled] rule fades this to .5 */
      background: #f4f4f4;
      color: #4a4a4a;
      border: 1px solid #d0d0d0;
      text-transform: uppercase;
      letter-spacing: .03em;
      cursor: not-allowed;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-payment-button {
      margin-top: 9px;
    }
    #vistagato-mobile-cart-bar-{{ section.id }} .vg-payment-button .shopify-payment-button__button {
      min-height: 44px !important;
      border-radius: 999px !important;
      overflow: hidden !important;
    }
  }

  @media screen and (min-width: 769px) {
    #vistagato-mobile-cart-bar-{{ section.id }} {
      display: none !important;
    }
  }
</style>

<div id="vistagato-mobile-cart-bar-{{ section.id }}">
{% assign sticky_form_id = 'vistagato-mobile-sticky-form-' | append: section.id %}
{% form 'product', product, id: sticky_form_id %}    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
      id="vistagato-mobile-variant-id-{{ section.id }}"
    >

    <div class="vg-product-row">
      {% if product.featured_image %}
        <img
          class="vg-product-image"
          src="{{ product.featured_image | image_url: width: 160 }}"
          alt="{{ product.title | escape }}"
          loading="lazy"
        >
      {% endif %}

      <div class="vg-product-info">
        <p class="vg-product-title">{{ product.title }}</p>
        <div class="vg-product-price">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>
      </div>
    </div>

    <div class="vg-action-row">
      <div class="vg-qty">
        <button type="button" class="vg-minus">−</button>
        <input type="number" name="quantity" value="1" min="1" id="vistagato-mobile-qty-{{ section.id }}">
        <button type="button" class="vg-plus">+</button>
      </div>

      <button type="submit" name="add" class="vg-add-to-cart"{% unless product.available %} disabled{% endunless %}>
        {% if product.available %}
          Add to cart
        {% else %}
          {{ 'products.product.sold_out_high_demand' | t }}
        {% endif %}
      </button>
    </div>

    {% if product.available %}
      <div class="vg-payment-button">
        {{ form | payment_button }}
      </div>
    {% endif %}
  {% endform %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var bar = document.getElementById('vistagato-mobile-cart-bar-{{ section.id }}');
    if (!bar) return;

    var qtyInput = document.getElementById('vistagato-mobile-qty-{{ section.id }}');
    var minus = bar.querySelector('.vg-minus');
    var plus = bar.querySelector('.vg-plus');
    var stickyVariantInput = document.getElementById('vistagato-mobile-variant-id-{{ section.id }}');

    if (minus && qtyInput) {
      minus.addEventListener('click', function () {
        var value = parseInt(qtyInput.value || '1', 10);
        qtyInput.value = Math.max(1, value - 1);
      });
    }

    if (plus && qtyInput) {
      plus.addEventListener('click', function () {
        var value = parseInt(qtyInput.value || '1', 10);
        qtyInput.value = value + 1;
      });
    }

    function syncVariantId() {
      // Looks specifically inside this section's container so it doesn't grab the wrong variant if there are multiple products on the page
      var sectionContainer = document.getElementById('m-featured-product-{{ section.id }}');
      if (sectionContainer) {
        var activeVariantInput = sectionContainer.querySelector('form[action*="/cart/add"] input[name="id"]:not(#vistagato-mobile-variant-id-{{ section.id }})');
        if (activeVariantInput && stickyVariantInput) {
          stickyVariantInput.value = activeVariantInput.value;
        }
      }
    }

    // Only sync if the user interacts with THIS specific section
    document.addEventListener('change', function (e) {
      if(e.target.closest('#m-featured-product-{{ section.id }}')) {
        setTimeout(syncVariantId, 150);
        setTimeout(syncVariantId, 400);
      }
    });

    document.addEventListener('click', function (e) {
      if(e.target.closest('#m-featured-product-{{ section.id }}')) {
        setTimeout(syncVariantId, 150);
        setTimeout(syncVariantId, 400);
      }
    });

    syncVariantId();
  });
</script>
{% endif %}
